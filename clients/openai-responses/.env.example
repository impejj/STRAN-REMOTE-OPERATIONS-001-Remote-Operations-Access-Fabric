# Never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=

# SROF OAuth. If SROF_ACCESS_TOKEN is omitted, the client performs
# Authorization Code + PKCE in the local browser and keeps the token in memory.
SROF_OAUTH_ISSUER=https://auth.scientiam.com.ar/realms/scientiam-srof
SROF_OAUTH_CLIENT_ID=srof-openai-responses-cli
SROF_OAUTH_PORT=8766
# Optional break-glass/testing injection; do not persist real tokens:
# SROF_ACCESS_TOKEN=

SROF_MCP_URL=https://srof.scientiam.com.ar/mcp
# Optional:
# SROF_OPENAI_EVIDENCE_DIR=/var/lib/scientiam/remote-ops/client-receipts
# SROF_OPENAI_TIMEOUT=120
# SROF_OAUTH_TIMEOUT=300
