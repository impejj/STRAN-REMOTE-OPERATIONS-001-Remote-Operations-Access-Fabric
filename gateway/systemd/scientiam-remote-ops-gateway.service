[Unit]
Description=SCIENTIAM Remote Operations Fabric MCP Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scientiam-remoteops
Group=scientiam-remoteops
WorkingDirectory=/opt/scientiam/remote-ops-gateway
Environment=SROF_HOSTS_FILE=/etc/scientiam/remote-ops/hosts.json
Environment=SROF_RECEIPT_DIR=/var/lib/scientiam/remote-ops/receipts
Environment=SROF_MCP_TRANSPORT=streamable-http
Environment=SROF_MCP_HOST=127.0.0.1
Environment=SROF_MCP_PORT=8765
Environment=SROF_MCP_PATH=/mcp
ExecStart=/opt/scientiam/remote-ops-gateway/.venv/bin/python -m srof_gateway.server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/scientiam/remote-ops
ReadOnlyPaths=/etc/scientiam/remote-ops
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
