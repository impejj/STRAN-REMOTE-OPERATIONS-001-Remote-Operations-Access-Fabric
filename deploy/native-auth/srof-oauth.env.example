# Install as /etc/scientiam/remote-ops/srof-oauth.env only after
# local Keycloak discovery and policy checks pass.
SROF_OAUTH_REQUIRED=1
SROF_OAUTH_ISSUER=https://auth.scientiam.com.ar/realms/scientiam-srof
SROF_OAUTH_RESOURCE=https://srof.scientiam.com.ar/mcp
SROF_OAUTH_REQUIRED_SCOPES=srof:read
SROF_OAUTH_ALGORITHMS=RS256
SROF_PUBLIC_HOSTNAME=srof.scientiam.com.ar
SROF_ALLOWED_ORIGINS=https://chatgpt.com https://srof.scientiam.com.ar
