# SROF Cloudflare Tunnel example.
# DO NOT COMMIT tunnel credentials or tokens.
#
# Replace:
#   <TUNNEL_UUID>
#   <CREDENTIALS_JSON>
#   <SROF_PUBLIC_HOSTNAME>
#   <CLOUDFLARE_TEAM_NAME>
#   <ACCESS_APPLICATION_AUD>
#
# SROF remains loopback-only. cloudflared validates Cloudflare Access JWTs
# before proxying requests to the local MCP origin.

tunnel: <TUNNEL_UUID>
credentials-file: <CREDENTIALS_JSON>

ingress:
  - hostname: <SROF_PUBLIC_HOSTNAME>
    service: http://127.0.0.1:8765
    originRequest:
      connectTimeout: 10s
      access:
        required: true
        teamName: <CLOUDFLARE_TEAM_NAME>
        audTag:
          - <ACCESS_APPLICATION_AUD>
  - service: http_status:404
