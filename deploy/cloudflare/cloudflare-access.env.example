# Non-secret Cloudflare Access metadata for SROF.
# Install as /etc/scientiam/remote-ops/cloudflare-access.env only after
# Cloudflare Access/MCP configuration exists.

SROF_CF_ACCESS_REQUIRED=1
SROF_CF_TEAM_DOMAIN=REPLACE.cloudflareaccess.com
SROF_CF_ACCESS_AUD=REPLACE_WITH_APPLICATION_AUD
# Optional:
# SROF_LOG_LEVEL=info
