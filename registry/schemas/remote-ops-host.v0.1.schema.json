{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientiam.local/schemas/remote-ops-host.v0.1.schema.json",
  "title": "SCIENTIAM Remote Ops Host v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "host_id",
    "owner_id",
    "ssh_alias",
    "capabilities",
    "allowed_roots",
    "allowed_data_classes",
    "lifecycle_state"
  ],
  "properties": {
    "schema": {
      "const": "SCIENTIAM_REMOTE_OPS_HOST/0.1"
    },
    "host_id": {
      "type": "string",
      "minLength": 3
    },
    "owner_id": {
      "type": "string",
      "minLength": 2
    },
    "ssh_alias": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "FILESYSTEM",
          "PROCESS",
          "SYSTEMD",
          "DOCKER",
          "GIT",
          "JOURNAL",
          "NETWORK",
          "GUI"
        ]
      }
    },
    "allowed_roots": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/"
      }
    },
    "allowed_services": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "allowed_containers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "allowed_repositories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "allowed_data_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PUBLIC",
          "SYNTHETIC",
          "INTERNAL_LOW",
          "CONFIDENTIAL",
          "RESTRICTED"
        ]
      }
    },
    "lifecycle_state": {
      "enum": [
        "DISCOVERED",
        "REGISTERED",
        "AUTHORIZED",
        "HEALTH_OK",
        "EXECUTION_OK",
        "EVIDENCE_OK",
        "PRODUCTION_READY",
        "PAUSED",
        "DRAINING",
        "REVOKED"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "FILESYSTEM"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "allowed_roots": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "GIT"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "allowed_repositories": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
